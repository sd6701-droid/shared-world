# Required. From reactor.inc/account/api-keys (apply the hackathon promo code there).
REACTOR_API_KEY=rk_your_api_key_here

# Optional. Lets the director understand free-form replies with Gemini.
# Without it, choices are matched by keywords, which is fine for a demo.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional. Reactor API base URL. Defaults to https://api.reactor.inc
# NEXT_PUBLIC_REACTOR_API_URL=
